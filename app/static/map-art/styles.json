{
  "version": 2,
  "note": "地图渲染风格（app/map_render.py 读取）。美术只决定怎么画，不改地形：海陆/高程/分类一律来自 app/terrain_source.py 的查询结果；海按 status=OCEAN 判，不按 height<0。尺寸类数值单位为「参考像素」，以 2048 px 宽的显示图为准，按实际显示尺寸等比缩放；高程/水深/起伏阈值单位为米。纸纹、晕染、水纹、海岸描边都是叠在数据上的显示纹理，海岸线条只画在海一侧。 三种风格：simple（简化地图，沿用 map-art.svg 全部符号含地形符号）、medieval（西式手绘，专属 map-art-medieval.svg，只有城市/资源/道路图示，不叠地形符号）、eastern（东方古舆图，专属 map-art-eastern.svg，同样不叠地形符号）。layers 声明各风格开启的符号层；medieval / eastern 连高程点（▲ 加数字）也关闭，图面上不出现任何山形标记，地形只由分层设色 + 阴影表现。",
  "reference_px": 2048,
  "terrain_symbols": {
    "note": "按 manifest.json dem_hints 落地的阈值（米）。局部起伏 = 窗口内陆地最高-最低；只在 LAND 样点的局部极大处放山/雪峰/丘陵；沼泽 = 坡度近零的低洼陆地，属近似（本数据无湿地/群系）。",
    "relief_window_m": 3000,
    "peak_window_m": 1800,
    "mountain_relief_m": 640,
    "hill_relief_m": 330,
    "snowline_m": 2900,
    "marsh_slope_max": 0.008,
    "marsh_elevation_max_m": 25,
    "marsh_box_px": 28,
    "marsh_min_fraction": 0.6
  },
  "icon_sets": {
    "note": "medieval / eastern 两套图示必须恰好包含这些 id；资源 id 与 manifest.json resources（kinds + trade_kinds）同名，数据层可跨风格共用。",
    "towns": ["town-hamlet", "town-town", "town-city", "town-capital"],
    "resources_from_manifest": true,
    "route_marks": ["mark-bridge", "mark-ford", "mark-pass", "mark-port"]
  },
