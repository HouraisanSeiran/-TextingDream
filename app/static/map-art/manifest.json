{
  "version": 1,
  "style": "medieval-atlas",
  "note": "地图美术资产清单。为之后的 DEM/灰度图地图系统预备：只描述「用哪个符号/颜色」，不描述规则。资源符号只表示「此处有该资源候选」，不表示储量；种族与树种的来源字段在新地图系统接入前都需要作者确认。",
  "sprite": "/static/map-art/map-art.svg",
  "usage": "在页面内嵌或 fetch 后插入 map-art.svg，再用 <svg><use href=\"#town-human-city\"/></svg>；Canvas 绘制可把单个 symbol 包成独立 SVG 后转 Image 缓存。",
  "anchors": {
    "town": { "viewBox": [32, 32], "anchor": [16, 28], "note": "地面线中点对准城镇坐标" },
    "resource": { "viewBox": [24, 24], "anchor": [12, 12] },
    "tree": { "viewBox": [16, 20], "anchor": [8, 19] },
    "mark": { "viewBox": [24, 24], "anchor": [12, 21] },
    "terrain": { "viewBox": [24, 18], "anchor": [12, 17] }
  },
  "towns": {
    "races": {
      "human":    { "name": "人类",   "accent": "#a3472f", "motif": "砖红坡顶、城墙雉堞、旗帜" },
      "elf":      { "name": "精灵",   "accent": "#4f7a4a", "motif": "叶形尖塔、拱形廊、伴生树" },
      "dwarf":    { "name": "矮人",   "accent": "#5d6b78", "motif": "依山凿门、石砌方塔、锻炉烟囱" },
      "orc":      { "name": "兽人",   "accent": "#6b5a2a", "motif": "尖桩木栅、兽皮帐、骨角、血红旗" },
      "halfling": { "name": "半身人", "accent": "#7a8a3a", "motif": "山丘洞屋、圆门圆窗、小烟囱" }
    },
    "tiers": [
      { "id": "hamlet",  "name": "村落", "civ_kind": [0],    "size_px": 18 },
      { "id": "town",    "name": "城镇", "civ_kind": [1],    "size_px": 22 },
      { "id": "city",    "name": "城市", "civ_kind": [2, 3], "size_px": 26 },
      { "id": "capital", "name": "首都", "civ_kind": [4],    "size_px": 30 }
    ],
    "symbol_pattern": "town-{race}-{tier}",
    "civ_kind_note": "civ_kind 对应 civ-atlas host.tsx 里 ['村落','城镇','城市','大城','首都'] 的下标。",
    "race_source": "种族由地图生成之后的独立种族/城镇系统给出，美术层只接收 race id，不自行推断。未知种族回落到 human 图标。"
  },
  "resources": {
    "symbol_pattern": "res-{kind}",
    "source": "app/town_schema.py ResourceCandidate.kind",
    "kinds": {
      "iron": "铁矿", "coal": "煤矿", "copper": "铜矿", "tin": "锡矿", "gold": "金矿", "rare_metals": "稀有金属",
      "stone": "石料", "clay": "黏土", "salt": "盐", "timber": "木材", "grain": "谷物", "livestock": "牲畜",
      "fish": "渔获", "herb": "草药", "wool": "羊毛", "reed": "芦苇"
    },
    "trade_kinds": {
      "note": "第二批：贸易品与奇物。尚未进入 app/town_schema.py 的资源枚举；接入新地图系统前需要作者确认是否作为可开采资源。mana/dragonbone 为奇幻资源，只在世界设定声明时使用。",
      "silver": "银矿", "gems": "宝石", "marble": "大理石", "sulfur": "硫磺", "spices": "香料", "silk": "丝绸",
      "horses": "良马", "ivory": "象牙", "amber": "琥珀", "pearls": "珍珠", "wine": "葡萄与酒", "dye": "染料",
      "mana": "魔力晶簇（奇幻）", "dragonbone": "龙骨（奇幻）"
    },
    "unsurveyed_style": "未勘测的候选用 opacity .45 + 虚线外圈显示，不当作已知矿藏"
  },
  "trees": {
    "symbol_pattern": "tree-{species}",
