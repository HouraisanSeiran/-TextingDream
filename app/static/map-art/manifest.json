      "热带荒漠": { "cactus": 0.5, "palm": 0.3, "dragonblood": 0.2 },
      "稀树草原": { "acacia": 0.7, "baobab": 0.3 },
      "热带季雨林": { "teak": 0.4, "bamboo": 0.3, "acacia": 0.15, "palm": 0.15 },
      "热带雨林": { "kapok": 0.55, "bamboo": 0.15, "teak": 0.15, "palm": 0.15 },
      "湿地": { "willow": 0.45, "mangrove": 0.3, "birch": 0.15, "cypress": 0.1 }
    },
    "climate_variants": {
      "note": "同一群系内按气候细分的可选替换。新地图系统有季节降水/海拔时使用；没有就忽略。",
      "夏干冬湿（地中海式）": { "olive": 0.35, "cypress": 0.3, "cedar": 0.15, "oak": 0.2 },
      "东亚温带": { "cherry": 0.2, "maple": 0.3, "pine": 0.25, "bamboo": 0.25 },
      "高海拔山地": { "fir": 0.4, "cedar": 0.3, "spruce": 0.3 }
