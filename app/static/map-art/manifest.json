      "cypress": "柏/地中海柏", "cedar": "雪松（黎巴嫩雪松）", "fir": "冷杉", "chestnut": "栗", "ash": "白蜡/水曲柳", "elm": "榆",
      "yew": "红豆杉", "olive": "橄榄", "palm": "棕榈/椰子", "baobab": "猴面包树", "joshua": "约书亚树", "cactus": "仙人掌",
      "dragonblood": "龙血树", "cherry": "樱"
    },
    "fantasy_species": {
      "note": "奇幻树种不进 by_biome 默认配比；只有世界设定声明了对应区域（如精灵古林、腐化之地、地下菌林、魔力晶林）时才用。",
      "silverleaf": "银叶树（古林）", "gloomwood": "幽暗枯木（腐化/暗影之地）", "mushroom": "巨菌（菌林/地下）", "crystal": "晶树（魔力晶林）"
    },
    "by_biome": {
      "note": "按群系给出树种配比（权重和为 1）。是绘图时的默认配比，不是生态模型；新系统若有更细的气候或海拔信息可覆盖。",
      "针叶林": { "spruce": 0.35, "fir": 0.2, "pine": 0.25, "larch": 0.12, "birch": 0.08 },
      "苔原": { "larch": 0.6, "birch": 0.4 },
      "温带森林": { "oak": 0.25, "beech": 0.18, "maple": 0.12, "chestnut": 0.1, "ash": 0.1, "elm": 0.08, "birch": 0.07, "yew": 0.05, "pine": 0.05 },
