    "coastal_override": { "热带雨林": "mangrove", "热带季雨林": "mangrove", "湿地": "mangrove" },
    "density": { "针叶林": 0.75, "苔原": 0.12, "温带森林": 0.7, "温带雨林": 0.9, "草原": 0.06, "温带荒漠": 0.03, "热带荒漠": 0.02, "稀树草原": 0.15, "热带季雨林": 0.65, "热带雨林": 0.95, "湿地": 0.3 }
